class Vehicle {
    void move() {
        System.out.println("moving");
    }
}
class Bike extends Vehicle {
    void ride() {
        System.out.println("riding");
    }
}
class Car extends Vehicle {
    void drive() {
        System.out.println("driving");
    }
}
public class Main {
    public static void main(String args[]) {
        Car c = new Car();
        c.drive();
        c.move();
        // c.ride(); // C.T. Error
    }
}
